{
  "name": "ical.js",
  "version": "3.0.0",
  "author": "Philipp Kewisch",
  "contributors": [
    "Github Contributors (https://github.com/kewisch/ical.js/graphs/contributors)"
  ],
  "description": "Javascript parser for ics (rfc5545) and vcard (rfc6350) data",
  "main": "dist/ical.cjs",
  "module": "dist/ical.js",
  "types": "dist/types/module.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kewisch/ical.js.git"
  },
  "keywords": [
    "calendar",
    "iCalendar",
    "jCal",
    "vCard",
    "jCard",
    "parser"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@octokit/core": "^7.0.8",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "benchmark": "^2.1.4",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "clean-jsdoc-theme": "^5.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-html": "^8.2.0",
    "globals": "^17.12.0",
    "jsdoc": "^4.0.5",
    "jsdoc-tsimport-plugin": "^1.0.5",
    "mocha": "^12.0.1",
    "node-fetch": "^3.3.2",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "yauzl-promise": "^4.0.0"
  },
  "license": "MPL-2.0",
  "engine": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "npm run test-unit && npm run test-acceptance",
    "test-unit": "c8 mocha",
    "test-acceptance": "mocha test/acceptance/*_test.js",
    "test-performance": "mocha --reporter test/support/perfReporter.cjs test/performance/*_test.js",
    "test-browser": "web-test-runner",
    "test-all": "npm run test-unit && npm run test-acceptance && npm run test-performance && npm run test-browser",
    "build": "vite build && vite build --mode development && tsc --project tsconfig.json",
    "lint": "eslint",
    "jsdoc": "node tools/build-jsdoc.js",
    "validator": "node tools/scriptutils.js replace-unpkg tools/validator.html docs/validator.html",
    "recurtester": "node tools/scriptutils.js replace-unpkg tools/recur-tester.html docs/recur-tester.html",
    "ghpages": "npm run jsdoc && npm run validator && npm run recurtester"
  },
  "exports": {
    ".": {
      "types": "./dist/types/module.d.ts",
      "import": "./dist/ical.js",
      "require": "./dist/ical.cjs"
    },
    "./browser": "./dist/ical.browser.js"
  },
  "files": [
    "dist/ical.js",
    "dist/ical.min.js",
    "dist/ical.cjs",
    "dist/ical.min.cjs",
    "dist/ical.browser.js",
    "dist/ical.browser.min.js",
    "dist/ical*.map",
    "dist/types/*",
    "lib/ical/*.js"
  ]
}
